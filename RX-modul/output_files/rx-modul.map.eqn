samples_reg[5] = DFFEAS(A1L336, clk, rst,  ,  ,  ,  ,  ,  );


--A1L24 is LessThan0~0
A1L24 = samples_reg[4] $ (samples_reg[2] $ (samples_reg[5]));


--A1L25 is LessThan0~1
A1L25 = (samples_reg[4] & ((samples_reg[2]) # (samples_reg[5]))) # (!samples_reg[4] & (samples_reg[2] & samples_reg[5]));


--A1L26 is LessThan0~2
A1L26 = (samples_reg[6] & ((A1L25) # ((samples_reg[3] & A1L24)))) # (!samples_reg[6] & (A1L25 & ((samples_reg[3]) # (A1L24))));


--A1L27 is p1_process~0
A1L27 = shift_reg[4] $ (shift_reg[5] $ (shift_reg[6] $ (shift_reg[7])));


--A1L28 is p1_process~1
A1L28 = shift_reg[0] $ (shift_reg[1] $ (shift_reg[2] $ (shift_reg[3])));


--A1L29 is p1_process~2
A1L29 = A1L27 $ (A1L28);


--state.PARITY_CHECK is state.PARITY_CHECK
--register power-up is low

state.PARITY_CHECK = DFFEAS(state.SAMPLING, clk, rst,  , A1L375,  ,  ,  ,  );


--sample_count[2] is sample_count[2]
--register power-up is low

sample_count[2] = DFFEAS(A1L325, clk, rst,  ,  ,  ,  ,  ,  );


--sample_count[1] is sample_count[1]
