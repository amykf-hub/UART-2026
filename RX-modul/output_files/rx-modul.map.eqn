--clk is clk
clk = INPUT();


--rst is rst
rst = INPUT();


--rx_tick is rx_tick
rx_tick = INPUT();


--state.DONE is state.DONE
--register power-up is low

state.DONE = DFFEAS(A1L352, clk, rst,  , rx_tick,  ,  ,  ,  );


--A1L295 is rx_data[0]~0
A1L295 = (rx_tick & state.DONE);


--shift_reg[1] is shift_reg[1]
--register power-up is low

shift_reg[1] = DFFEAS(shift_reg[2], clk, rst,  , A1L355,  ,  ,  ,  );


