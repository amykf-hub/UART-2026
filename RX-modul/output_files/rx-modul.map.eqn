--buffer_counter[4] is buffer_counter[4]
--register power-up is low

buffer_counter[4] = DFFEAS(A1L19, clk, rst,  , A1L37,  ,  ,  ,  );


--buffer_counter[3] is buffer_counter[3]
--register power-up is low

buffer_counter[3] = DFFEAS(A1L16, clk, rst,  , A1L37,  ,  ,  ,  );


--buffer_counter[2] is buffer_counter[2]
--register power-up is low

buffer_counter[2] = DFFEAS(A1L13, clk, rst,  , A1L37,  ,  ,  ,  );


--buffer_counter[1] is buffer_counter[1]
--register power-up is low

buffer_counter[1] = DFFEAS(A1L10, clk, rst,  , A1L37,  ,  ,  ,  );


--A1L10 is buffer_counter[1]~4
A1L10 = (buffer_counter[0] & (buffer_counter[1] $ (VCC))) # (!buffer_counter[0] & (buffer_counter[1] & VCC));

--A1L11 is buffer_counter[1]~5
A1L11 = CARRY((buffer_counter[0] & buffer_counter[1]));


--A1L13 is buffer_counter[2]~6
A1L13 = (buffer_counter[2] & (!A1L11)) # (!buffer_counter[2] & ((A1L11) # (GND)));

--A1L14 is buffer_counter[2]~7
A1L14 = CARRY((!A1L11) # (!buffer_counter[2]));


--A1L16 is buffer_counter[3]~8
A1L16 = (buffer_counter[3] & (A1L14 $ (GND))) # (!buffer_counter[3] & (!A1L14 & VCC));

--A1L17 is buffer_counter[3]~9
A1L17 = CARRY((buffer_counter[3] & !A1L14));


--A1L19 is buffer_counter[4]~10
A1L19 = buffer_counter[4] $ (A1L17);


