--A1L37 is rx_buffer[0]~0
A1L37 = (rx_tick & (state.DONE & !buffer_counter[4]));


--samples_reg[6] is samples_reg[6]
--register power-up is low

samples_reg[6] = DFFEAS(A1L340, clk, rst,  ,  ,  ,  ,  ,  );


--samples_reg[3] is samples_reg[3]
