sample_count[1] = DFFEAS(A1L320, clk, rst,  ,  ,  ,  ,  ,  );


--sample_count[0] is sample_count[0]
--register power-up is low

sample_count[0] = DFFEAS(A1L318, clk, rst,  ,  ,  ,  ,  ,  );


--A1L23 is Equal2~0
A1L23 = (sample_count[2] & (sample_count[1] & sample_count[0]));


--A1L31 is parity_wrong~0
A1L31 = (rx_tick & (state.PARITY_CHECK & A1L23));


--A1L32 is parity_wrong~1
A1L32 = (A1L31 & (A1L26 $ ((A1L29)))) # (!A1L31 & (((A1L33Q))));


