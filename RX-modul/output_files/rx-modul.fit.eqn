--buffer_counter[4] is buffer_counter[4] at FF_X27_Y15_N27
--register power-up is low

buffer_counter[4] = DFFEAS(A1L20, GLOBAL(A1L24), GLOBAL(A1L40),  , A1L43,  ,  ,  ,  );


--buffer_counter[3] is buffer_counter[3] at FF_X27_Y15_N25
--register power-up is low

buffer_counter[3] = DFFEAS(A1L17, GLOBAL(A1L24), GLOBAL(A1L40),  , A1L43,  ,  ,  ,  );


--buffer_counter[2] is buffer_counter[2] at FF_X27_Y15_N23
--register power-up is low

buffer_counter[2] = DFFEAS(A1L14, GLOBAL(A1L24), GLOBAL(A1L40),  , A1L43,  ,  ,  ,  );


--buffer_counter[1] is buffer_counter[1] at FF_X27_Y15_N21
--register power-up is low

buffer_counter[1] = DFFEAS(A1L11, GLOBAL(A1L24), GLOBAL(A1L40),  , A1L43,  ,  ,  ,  );


--A1L11 is buffer_counter[1]~4 at LCCOMB_X27_Y15_N20
A1L11 = (buffer_counter[0] & (buffer_counter[1] $ (VCC))) # (!buffer_counter[0] & (buffer_counter[1] & VCC));

--A1L12 is buffer_counter[1]~5 at LCCOMB_X27_Y15_N20
A1L12 = CARRY((buffer_counter[0] & buffer_counter[1]));


--A1L14 is buffer_counter[2]~6 at LCCOMB_X27_Y15_N22
A1L14 = (buffer_counter[2] & (!A1L12)) # (!buffer_counter[2] & ((A1L12) # (GND)));

--A1L15 is buffer_counter[2]~7 at LCCOMB_X27_Y15_N22
A1L15 = CARRY((!A1L12) # (!buffer_counter[2]));


--A1L17 is buffer_counter[3]~8 at LCCOMB_X27_Y15_N24
A1L17 = (buffer_counter[3] & (A1L15 $ (GND))) # (!buffer_counter[3] & (!A1L15 & VCC));

--A1L18 is buffer_counter[3]~9 at LCCOMB_X27_Y15_N24
A1L18 = CARRY((buffer_counter[3] & !A1L15));


--A1L20 is buffer_counter[4]~10 at LCCOMB_X27_Y15_N26
A1L20 = buffer_counter[4] $ (A1L18);


